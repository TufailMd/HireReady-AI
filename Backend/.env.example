# Database
# Required: MongoDB connection string used when the backend starts.
MONGO_URI=<your-mongodb-connection-string>

# Required for registration, login, and token verification.
JWT_SECRET=<generate-a-long-random-secret>

# Required for AI interview report and resume generation.
GOOGLE_API_KEY=<your-google-api-key>

GOOGLE_MODEL=<your-google-model>

ALLOWED_ORIGIN=<your-allowed-origin-for-cors>
